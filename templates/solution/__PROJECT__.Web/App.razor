@using __PROJECT__.Shared.Components
@using __PROJECT__.Shared.Layouts
@using __PROJECT__.Shared.Pages
@inject IJSRuntime JS
@inject LanguageService L
@implements IDisposable

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="ryz-route-overlay" aria-hidden="true">
    <div class="ryz-route-overlay-card" role="status" aria-live="polite">
        <img src="images/branding/app-logo.png" alt="" />
        <div class="ryz-route-overlay-title">@L["PreparingWorkspace"]</div>
        <div class="ryz-route-overlay-track">
            <div class="ryz-route-overlay-bar"></div>
        </div>
    </div>
</div>

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Login).Assembly" NotFoundPage="@typeof(ErrorPage)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("ryzBootReady");
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
