@inject SettingApiService SettingApi
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_model.UserId" Label="@L["User"]" Variant="Variant.Outlined" Required="true" Disabled="@IsEdit" Clearable="true">
                    @foreach (var user in _users)
                    {
                        <MudSelectItem Value="@user.Value">@user.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_model.GroupId" Label="@L["Group"]" Variant="Variant.Outlined" Required="true" Clearable="true">
                    @foreach (var group in _groups)
                    {
                        <MudSelectItem Value="@group.Value">@group.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" Class="d-flex align-items-center">
                <MudSwitch T="bool" @bind-Value="_model.CanAddEdit" Color="Color.Primary" Label="@L["AddEditColumn"]" />
            </MudItem>
            <MudItem xs="12" Class="d-flex align-items-center">
                <MudSwitch T="bool" @bind-Value="_model.CanDelete" Color="Color.Primary" Label="@L["DeleteColumn"]" />
            </MudItem>
            <MudItem xs="12" Class="d-flex align-items-center">
                <MudSwitch T="bool" @bind-Value="_model.CanReadOnly" Color="Color.Primary" Label="@L["ReadOnlyColumn"]" />
            </MudItem>
            <MudItem xs="12" Class="d-flex align-items-center">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="@L["Active"]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="@(_ => SubmitAsync())">
            @(_saving ? L["Saving"] : L["Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public RoleEditDto? Role { get; set; }

    private RoleEditDto _model = new();
    private List<DropdownItemDto> _groups = new();
    private List<DropdownItemDto> _users = new();
    private bool _saving;

    private bool IsEdit => Role != null;
    private string Title => IsEdit ? L["EditRole"] : L["AddRole"];

    protected override async Task OnInitializedAsync()
    {
        L.OnChange += HandleLanguageChanged;
        _groups = await SettingApi.GetGroupsAsync();
        _users = await SettingApi.GetUsersAsync();

        if (Role != null)
        {
            _model = new RoleEditDto
            {
                UserId = Role.UserId,
                GroupId = Role.GroupId,
                CanAddEdit = Role.CanAddEdit,
                CanDelete = Role.CanDelete,
                CanReadOnly = Role.CanReadOnly,
                IsActive = Role.IsActive,
            };
        }
    }

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.UserId) || string.IsNullOrWhiteSpace(_model.GroupId))
        {
            Snackbar.Add(L["UserAndGroupRequired"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = IsEdit
                ? await SettingApi.UpdateRoleAsync(Role!.UserId, _model)
                : await SettingApi.CreateRoleAsync(_model);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? L["Saved"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? L["SaveFailed"], Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
