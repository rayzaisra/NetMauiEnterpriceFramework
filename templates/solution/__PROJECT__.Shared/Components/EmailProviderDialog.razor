@using __PROJECT__.Application.DTOs.Email
@inject EmailProviderApiService EmailProviderApi
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? L["EditEmailProvider"] : L["AddEmailProvider"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_model.ProviderType" Label="@L["ProviderType"]" Variant="Variant.Outlined" Required="true" Clearable="true">
                    <MudSelectItem Value="@("SMTP")">SMTP</MudSelectItem>
                    <MudSelectItem Value="@("GMAIL")">Gmail API (OAuth)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.ProviderName" Label="@L["ProviderName"]" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.FromEmail" Label="@L["FromEmail"]" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.FromName" Label="@L["FromName"]" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="_model.Priority" Label="@L["Priority"]" Variant="Variant.Outlined" Min="1" />
            </MudItem>
            <MudItem xs="12" md="6"></MudItem>

            @if (IsSmtp)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Host" Label="@L["SmtpHost"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int" @bind-Value="_model.Port" Label="@L["Port"]" Variant="Variant.Outlined" Min="1" Max="65535" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Username" Label="@L["SmtpUsername"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Password"
                                  Label="@L["SmtpPassword"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  HelperText="@(_model.HasPassword ? L["LeaveBlankKeepPassword"] : null)" />
                </MudItem>
                <MudItem xs="12" Class="d-flex align-items-center">
                    <MudSwitch T="bool" @bind-Value="_model.EnableSsl" Color="Color.Primary" Label="@L["UseSslTls"]" />
                </MudItem>
            }
            else if (IsGmail)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ClientId" Label="@L["OAuthClientId"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ClientSecret"
                                  Label="@L["OAuthClientSecret"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  HelperText="@(_model.HasClientSecret ? L["LeaveBlankKeepSecret"] : null)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.RefreshToken"
                                  Label="@L["OAuthRefreshToken"]"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  HelperText="@(_model.HasRefreshToken ? L["LeaveBlankKeepToken"] : null)" />
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info">
                        @L["GmailRefreshTokenScope"]
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12" Class="d-flex align-items-center">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="@L["Active"]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="SubmitAsync">
            @(_saving ? L["Saving"] : L["Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public EmailProviderDto? Provider { get; set; }

    private EmailProviderDto _model = new();
    private bool _saving;

    private bool IsEdit => _model.Id != 0;
    private bool IsSmtp => string.Equals(_model.ProviderType, "SMTP", StringComparison.OrdinalIgnoreCase);
    private bool IsGmail => string.Equals(_model.ProviderType, "GMAIL", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        if (Provider != null)
        {
            _model = Provider;
        }
    }

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        if (!IsSmtp && !IsGmail)
        {
            Snackbar.Add(L["SelectSmtpOrGmail"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.FromEmail))
        {
            Snackbar.Add(L["FromEmailRequired"], Severity.Warning);
            return;
        }

        if (IsSmtp && (string.IsNullOrWhiteSpace(_model.Host) || (!_model.HasPassword && string.IsNullOrWhiteSpace(_model.Password))))
        {
            Snackbar.Add(L["SmtpHostPasswordRequired"], Severity.Warning);
            return;
        }

        if (IsGmail
            && (string.IsNullOrWhiteSpace(_model.ClientId)
                || (!_model.HasClientSecret && string.IsNullOrWhiteSpace(_model.ClientSecret))
                || (!_model.HasRefreshToken && string.IsNullOrWhiteSpace(_model.RefreshToken))))
        {
            Snackbar.Add(L["GmailOauthRequired"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = await EmailProviderApi.SaveAsync(_model);
            if (!result.Success)
            {
                Snackbar.Add(result.Message ?? L["SaveFailed"], Severity.Error);
                return;
            }

            Snackbar.Add(result.Message ?? L["EmailProviderSaved"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
