@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["EditProfile"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_fullName" Label="@L["FullName"]" Variant="Variant.Outlined" Required="true" />
        <MudTextField @bind-Value="_email" Label="@L["Email"]" Variant="Variant.Outlined" InputType="InputType.Email" />
        <MudTextField @bind-Value="_phoneNumber" Label="@L["PhoneNumberColumn"]" Variant="Variant.Outlined" />
        <MudSelect T="string" @bind-Value="_genderId" Label="@L["GenderColumn"]" Variant="Variant.Outlined" Class="mt-4" Clearable="true">
            <MudSelectItem Value="@("L")">@L["Male"]</MudSelectItem>
            <MudSelectItem Value="@("P")">@L["Female"]</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="SaveAsync">
            @(_saving ? L["Saving"] : L["SaveChanges"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserResponseDto User { get; set; } = new();

    private string? _fullName;
    private string? _email;
    private string? _phoneNumber;
    private string? _genderId;
    private bool _saving;

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        _fullName = User.FullName;
        _email = User.Email;
        _phoneNumber = User.PhoneNumber;
        _genderId = User.GenderId;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_fullName))
        {
            Snackbar.Add(L["FullNameRequired"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = await AuthService.UpdateProfileAsync(new UpdateProfileDto
            {
                FullName = _fullName,
                Email = _email,
                PhoneNumber = _phoneNumber,
                GenderId = _genderId,
            });

            if (result != null)
            {
                Snackbar.Add(L["ProfileUpdatedSuccess"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(result));
            }
            else
            {
                Snackbar.Add(L["ProfileUpdateFailed"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
