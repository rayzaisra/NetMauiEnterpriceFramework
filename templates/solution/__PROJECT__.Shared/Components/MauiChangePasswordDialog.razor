@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["ChangePassword"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="@L["CurrentPassword"]"
                              @bind-Value="_model.CurrentPassword"
                              InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showCurrent = !_showCurrent)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="@L["NewPassword"]"
                              @bind-Value="_model.NewPassword"
                              InputType="@(_showNew ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showNew = !_showNew)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="@L["ConfirmNewPassword"]"
                              @bind-Value="_model.ConfirmNewPassword"
                              InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="SaveAsync">
            @(_saving ? L["Saving"] : L["Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly ChangePasswordDto _model = new();
    private bool _saving;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;
    private string? _error;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _error = null;

        if (string.IsNullOrWhiteSpace(_model.CurrentPassword)
            || string.IsNullOrWhiteSpace(_model.NewPassword)
            || string.IsNullOrWhiteSpace(_model.ConfirmNewPassword))
        {
            _error = L["AllPasswordFieldsRequired"];
            return;
        }

        if (_model.NewPassword != _model.ConfirmNewPassword)
        {
            _error = L["PasswordsDoNotMatch"];
            return;
        }

        _saving = true;
        try
        {
            await AuthService.ChangePasswordAsync(_model);
            Snackbar.Add(L["PasswordChangedSuccess"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
