@inject LanguageService L
@implements IDisposable

@* Global process overlay. Visibility and animation are driven by ryzcore-motion.js. *@
<div class="ryz-process-overlay" aria-hidden="true">
    <div class="ryz-process-card" role="status" aria-live="polite">
        <div class="ryz-process-visual" aria-hidden="true">
            <span class="ryz-process-ring ring-1"></span>
            <span class="ryz-process-ring ring-2"></span>
            <span class="ryz-process-ring ring-3"></span>
            <span class="ryz-process-dot dot-1"></span>
            <span class="ryz-process-dot dot-2"></span>
            <span class="ryz-process-dot dot-3"></span>
        </div>
        <div class="ryz-process-body">
            <div class="ryz-process-title">@L["Processing"]</div>
            <div class="ryz-process-stage">@L["PleaseWait"]</div>
            <div class="ryz-process-track">
                <div class="ryz-process-bar"></div>
            </div>
            <div class="ryz-process-percent">0%</div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
