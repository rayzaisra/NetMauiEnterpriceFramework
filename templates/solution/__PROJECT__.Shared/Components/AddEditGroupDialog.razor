@inject SettingApiService SettingApi
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.GroupId" Label="@L["GroupIdColumn"]" Variant="Variant.Outlined" Required="true" Disabled="@IsEdit" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.GroupName" Label="@L["GroupNameColumn"]" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="@L["Active"]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="@(_ => SubmitAsync())">
            @(_saving ? L["Saving"] : L["Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public GroupEditDto? Group { get; set; }

    private GroupEditDto _model = new();
    private bool _saving;

    private bool IsEdit => Group != null;
    private string Title => IsEdit ? L["EditGroup"] : L["AddGroup"];

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        if (Group != null)
        {
            _model = new GroupEditDto
            {
                GroupId = Group.GroupId,
                GroupName = Group.GroupName,
                IsActive = Group.IsActive,
            };
        }
    }

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.GroupId) || string.IsNullOrWhiteSpace(_model.GroupName))
        {
            Snackbar.Add(L["GroupIdAndNameRequired"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = IsEdit
                ? await SettingApi.UpdateGroupAsync(Group!.GroupId, _model)
                : await SettingApi.CreateGroupAsync(_model);

            if (result.Success)
            {
                Snackbar.Add(result.Message ?? L["Saved"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? L["SaveFailed"], Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
