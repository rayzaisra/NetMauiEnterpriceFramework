@inject SettingApiService SettingApi
@inject ISnackbar Snackbar
@inject LanguageService L
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["ResetPasswordTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">@L["ResetPasswordFor"] <strong>@UserId</strong>.</MudText>
        <MudTextField @bind-Value="_password"
                      Label="@L["NewPassword"]"
                      Variant="Variant.Text"
                      InputType="InputType.Password"
                      Required="true" />
        <MudTextField @bind-Value="_confirmation"
                      Label="@L["ConfirmNewPassword"]"
                      Variant="Variant.Text"
                      InputType="InputType.Password"
                      Required="true"
                      Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(_ => MudDialog.Cancel())">@L["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="SubmitAsync">
            @(_saving ? L["Saving"] : L["ResetPasswordTitle"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private string _password = string.Empty;
    private string _confirmation = string.Empty;
    private bool _saving;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        if (_password.Length < 8)
        {
            Snackbar.Add(L["PasswordMinLength"], Severity.Warning);
            return;
        }

        if (!string.Equals(_password, _confirmation, StringComparison.Ordinal))
        {
            Snackbar.Add(L["PasswordsDoNotMatch"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = await SettingApi.ResetUserPasswordAsync(UserId, _password);
            if (result.Success)
            {
                Snackbar.Add(result.Message ?? L["PasswordResetSuccess"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? L["ResetFailed"], Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
