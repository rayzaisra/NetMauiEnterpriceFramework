@using MudBlazor
@inject LanguageService L
@implements IDisposable

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">@L["Maintenance"]</div>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Construction" Color="Color.Primary" Style="font-size:44px;" />
    </div>

    <MudAlert Severity="Severity.Info">
        @L["ModuleUnderDevelopment"]
    </MudAlert>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        if (string.IsNullOrWhiteSpace(Title)) Title = L["Maintenance"];
        if (string.IsNullOrWhiteSpace(Subtitle)) Subtitle = L["ModulePlaceholder"];
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title)) Title = L["Maintenance"];
        if (string.IsNullOrWhiteSpace(Subtitle)) Subtitle = L["ModulePlaceholder"];
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
