@page "/change-password"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject LanguageService L

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudPaper Elevation="0" Class="dashboard-card">
        <div class="dashboard-kicker">@L["Account"]</div>
        <h1>@L["ChangePassword"]</h1>
        <p>@L["UpdateYourAccountPassword"]</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <EditForm Model="@_model" OnValidSubmit="@OnSubmitAsync">
            <DataAnnotationsValidator />
            <div class="login-form-fields">
                <MudTextField @bind-Value="_model.CurrentPassword" Label="@L["CurrentPassword"]" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudTextField @bind-Value="_model.NewPassword" Label="@L["NewPassword"]" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudTextField @bind-Value="_model.ConfirmNewPassword" Label="@L["ConfirmNewPassword"]" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="@("ryz-busy-button" + (_isLoading ? " is-busy" : string.Empty))" Disabled="@_isLoading">@(_isLoading ? L["Processing"] : L["ChangePassword"])</MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly ChangePasswordDto _model = new();
    private bool _isLoading;
    private string? _error;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task OnSubmitAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _error = null;

        try
        {
            await AuthService.ChangePasswordAsync(_model);
            Snackbar.Add(L["PasswordChangedSuccessfully"], Severity.Success);
            Navigation.NavigateTo(OperatingSystem.IsBrowser() ? "/dashboard" : "/maui/dashboard");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
