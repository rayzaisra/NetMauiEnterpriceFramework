@page "/dashboard/maintenance/menu-list"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject SettingApiService SettingApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ExportApiService ExportApi
@inject NavigationManager Navigation
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Maintenance"]</div>
        <h1>@L["MenuMaintenance"]</h1>
        <p>@L["ManageMenusAndScreens"]</p>
    </div>
    <PermissionGate Action="PermissionAction.AddEdit">
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(_ => OpenAddAsync())">@L["AddMenu"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" Class="@("ryz-busy-button" + (_isExporting ? " is-busy" : string.Empty))" Disabled="@_isExporting" OnClick="ExportExcelAsync">
                @(_isExporting ? L["Exporting"] : L["ExportExcel"])
            </MudButton>
        </div>
    </PermissionGate>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="MenuListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchMenu"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="id">@L["IdColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="menuunique">@L["UniqueColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="menuname">@L["NameColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="parentlevelid">@L["LevelColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="menuparent">@L["ParentColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="orderseq">@L["OrderColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MenuListItemDto" SortLabel="isactive">@L["Status"]</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center; white-space:nowrap;">
                    <PermissionGate Action="PermissionAction.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => OpenEditAsync(context))" />
                    </PermissionGate>
                    <PermissionGate Action="PermissionAction.Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(_ => DeleteAsync(context))" />
                    </PermissionGate>
                </MudTd>
            </PermissionGate>
            <MudTd DataLabel="@L["IdColumn"]">@context.Id</MudTd>
            <MudTd DataLabel="@L["UniqueColumn"]">@context.MenuUnique</MudTd>
            <MudTd DataLabel="@L["NameColumn"]">@context.MenuName</MudTd>
            <MudTd DataLabel="@L["LevelColumn"]">@context.ParentLevelId</MudTd>
            <MudTd DataLabel="@L["ParentColumn"]">@(context.ParentName ?? context.MenuUniqueParent)</MudTd>
            <MudTd DataLabel="@L["OrderColumn"]">@context.OrderSeq</MudTd>
            <MudTd DataLabel="@L["Status"]">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Active"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Inactive"]</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoMenusFound"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Maintenance"], href: null),
        new(L["MenuMaintenance"], href: null, disabled: true),
    };

    private MudTable<MenuListItemDto>? _table;
    private string? _search;
    private bool _isExporting;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task<TableData<MenuListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var sortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc";
        var response = await SettingApi.GetMenusAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = sortDirection,
        });

        return new TableData<MenuListItemDto>
        {
            Items = response.Data,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var dialog = await DialogService.ShowAsync<AddEditMenuDialog>(L["AddMenu"]);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(MenuListItemDto menu)
    {
        var parameters = new DialogParameters
        {
            ["Menu"] = new MenuEditDto
            {
                Id = menu.Id,
                MenuUnique = menu.MenuUnique,
                MenuName = menu.MenuName,
                MenuUrl = menu.MenuUrl,
                ParentLevelId = menu.ParentLevelId,
                MenuUniqueParent = menu.MenuUniqueParent,
                MenuIcon = menu.MenuIcon,
                OrderSeq = menu.OrderSeq,
                ComponentType = menu.ComponentType,
                IsActive = menu.IsActive,
            },
        };

        var dialog = await DialogService.ShowAsync<AddEditMenuDialog>(L["EditMenu"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(MenuListItemDto menu)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = L["DeleteMenu"],
            ["Message"] = L.Format("DeleteMenuConfirm", menu.MenuName, menu.MenuUnique),
            ["ConfirmText"] = L["Delete"],
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["DeleteMenu"], parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await SettingApi.DeleteMenuAsync(menu.Id);
        Snackbar.Add(response.Message ?? L["DeleteFailed"], response.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private async Task ExportExcelAsync()
    {
        if (_isExporting)
        {
            return;
        }

        _isExporting = true;
        try
        {
            var url = await ExportApi.ExportManagementAsync("api/export/menus", _search);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add(L["ExportFailed"], Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
