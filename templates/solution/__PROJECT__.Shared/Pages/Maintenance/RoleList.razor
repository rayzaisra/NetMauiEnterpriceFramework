@page "/dashboard/maintenance/role-list"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject SettingApiService SettingApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ExportApiService ExportApi
@inject NavigationManager Navigation
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Maintenance"]</div>
        <h1>@L["RoleMaintenance"]</h1>
        <p>@L["ManageRolesAndAccess"]</p>
    </div>
    <PermissionGate Action="PermissionAction.AddEdit">
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(_ => OpenAddAsync())">@L["AddRole"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" Class="@("ryz-busy-button" + (_isExporting ? " is-busy" : string.Empty))" Disabled="@_isExporting" OnClick="ExportExcelAsync">
                @(_isExporting ? L["Exporting"] : L["ExportExcel"])
            </MudButton>
        </div>
    </PermissionGate>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="RoleListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchRole"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="userid">@L["UserIdColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="fullname">@L["FullName"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="groupname">@L["Group"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="canadded">@L["AddEditColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="candelete">@L["DeleteColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="canreadonly">@L["ReadOnlyColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleListItemDto" SortLabel="isactive">@L["Status"]</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center; white-space:nowrap;">
                    <PermissionGate Action="PermissionAction.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => OpenEditAsync(context))" />
                    </PermissionGate>
                    <PermissionGate Action="PermissionAction.Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(_ => DeleteAsync(context))" />
                    </PermissionGate>
                </MudTd>
            </PermissionGate>
            <MudTd DataLabel="@L["UserIdColumn"]">@context.UserId</MudTd>
            <MudTd DataLabel="@L["FullName"]">@context.FullName</MudTd>
            <MudTd DataLabel="@L["Group"]">@context.GroupName</MudTd>
            <MudTd DataLabel="@L["AddEditColumn"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.CanAddEdit ? Color.Success : Color.Default)">@(context.CanAddEdit ? L["Yes"] : L["No"])</MudChip>
            </MudTd>
            <MudTd DataLabel="@L["DeleteColumn"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.CanDelete ? Color.Success : Color.Default)">@(context.CanDelete ? L["Yes"] : L["No"])</MudChip>
            </MudTd>
            <MudTd DataLabel="@L["ReadOnlyColumn"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.CanReadOnly ? Color.Warning : Color.Default)">@(context.CanReadOnly ? L["Yes"] : L["No"])</MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Status"]">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Active"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Inactive"]</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoRolesFound"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Maintenance"], href: null),
        new(L["RoleMaintenance"], href: null, disabled: true),
    };

    private MudTable<RoleListItemDto>? _table;
    private string? _search;
    private bool _isExporting;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task<TableData<RoleListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var sortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc";
        var response = await SettingApi.GetRolesAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = sortDirection,
        });

        return new TableData<RoleListItemDto>
        {
            Items = response.Data,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var dialog = await DialogService.ShowAsync<AddEditRoleDialog>(L["AddRole"]);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(RoleListItemDto role)
    {
        var parameters = new DialogParameters
        {
            ["Role"] = new RoleEditDto
            {
                UserId = role.UserId,
                GroupId = role.GroupId,
                CanAddEdit = role.CanAddEdit,
                CanDelete = role.CanDelete,
                CanReadOnly = role.CanReadOnly,
                IsActive = role.IsActive,
            },
        };

        var dialog = await DialogService.ShowAsync<AddEditRoleDialog>(L["EditRole"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task ExportExcelAsync()
    {
        if (_isExporting)
        {
            return;
        }

        _isExporting = true;
        try
        {
            var url = await ExportApi.ExportManagementAsync("api/export/roles", _search);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add(L["ExportFailed"], Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task DeleteAsync(RoleListItemDto role)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = L["DeleteRole"],
            ["Message"] = L.Format("DeleteRoleConfirm", role.UserId),
            ["ConfirmText"] = L["Delete"],
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["DeleteRole"], parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await SettingApi.DeleteRoleAsync(role.UserId);
        Snackbar.Add(response.Message ?? L["DeleteFailed"], response.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
