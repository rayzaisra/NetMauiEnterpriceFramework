@page "/dashboard/maintenance/email-provider"
@layout AuthenticatedLayout
@using __PROJECT__.Application.DTOs.Email
@attribute [Authorize]
@implements IDisposable
@inject EmailProviderApiService EmailProviderApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">@L["Setting"]</div>
            <h1>@L["EmailProviderTitle"]</h1>
            <p>@L["ConfigureEmailProvider"]</p>
        </div>
        <PermissionGate Action="PermissionAction.AddEdit">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAsync">
                @L["AddProvider"]
            </MudButton>
        </PermissionGate>
    </div>

    <MudTable T="EmailProviderDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchProvider"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="providertype">@L["ProviderType"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="providername">@L["ProviderName"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="fromemail">@L["FromEmail"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="priority">@L["Priority"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="isactive">@L["Active"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="lasttestedat">@L["LastTest"]</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <PermissionGate AnyOf="PermissionSets.EditDelete">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center; white-space:nowrap;">
                    <PermissionGate Action="PermissionAction.AddEdit">
                        <MudIconButton Icon="@Icons.Material.Filled.Send"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       Disabled="@_testingId.HasValue"
                                       OnClick="@(_ => TestAsync(context))" />
                    </PermissionGate>
                    <PermissionGate Action="PermissionAction.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(_ => OpenEditAsync(context))" />
                    </PermissionGate>
                    <PermissionGate Action="PermissionAction.Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(_ => DeleteAsync(context))" />
                    </PermissionGate>
                </MudTd>
            </PermissionGate>
            <MudTd DataLabel="@L["ProviderType"]">@context.ProviderType</MudTd>
            <MudTd DataLabel="@L["ProviderName"]">@context.ProviderName</MudTd>
            <MudTd DataLabel="@L["FromEmail"]">@context.FromEmail</MudTd>
            <MudTd DataLabel="@L["Priority"]">@context.Priority</MudTd>
            <MudTd DataLabel="@L["Active"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? L["Active"] : L["Inactive"])
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["LastTest"]">
                @if (context.LastTestedAt.HasValue)
                {
                    <div>@context.LastTestStatus</div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.LastTestedAt.Value.ToString("yyyy-MM-dd HH:mm")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NotTested"]</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoEmailProviderConfigured"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Setting"], href: null),
        new(L["EmailProviderTitle"], href: null, disabled: true),
    };

    private MudTable<EmailProviderDto>? _table;
    private string? _search;
    private int? _testingId;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task<TableData<EmailProviderDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await EmailProviderApi.GetListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        return new TableData<EmailProviderDto>
        {
            Items = response.Data,
            TotalItems = response.Pagination.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var parameters = new DialogParameters<EmailProviderDialog>
        {
            { x => x.Provider, new EmailProviderDto() },
        };
        var dialog = await DialogService.ShowAsync<EmailProviderDialog>(L["AddEmailProvider"], parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(EmailProviderDto provider)
    {
        var parameters = new DialogParameters<EmailProviderDialog>
        {
            { x => x.Provider, provider },
        };
        var dialog = await DialogService.ShowAsync<EmailProviderDialog>(L["EditEmailProvider"], parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task TestAsync(EmailProviderDto provider)
    {
        _testingId = provider.Id;
        try
        {
            var result = await EmailProviderApi.TestAsync(provider.Id, null);
            Snackbar.Add(result.Message ?? (result.Success ? L["TestEmailSent"] : L["TestFailed"]),
                result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _testingId = null;
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(EmailProviderDto provider)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = L["DeleteEmailProvider"],
            ["Message"] = L.Format("DeleteEmailProviderConfirm", provider.ProviderName ?? provider.ProviderType),
            ["ConfirmText"] = L["Delete"],
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["DeleteEmailProvider"], parameters);
        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        var result = await EmailProviderApi.DeleteAsync(provider.Id);
        Snackbar.Add(result.Message ?? L["EmailProviderDeleted"], result.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
