@page "/dashboard/maintenance/user-flag"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject SettingApiService SettingApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Maintenance"]</div>
        <h1>@L["UserFlagManagement"]</h1>
        <p>@L["LockoutAndLoginFlags"]</p>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="UserFlagDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchByIdNameIp"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <PermissionGate AnyOf="PermissionSets.AddEdit">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="userid">@L["UserIdColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="fullname">@L["FullName"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="islogin">@L["IsLogin"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="isfirstlogin">@L["IsFirstLogin"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="islocked">@L["IsLocked"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="failedpasswordattempt">@L["FailedPasswordAttempt"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="ipaddress">@L["LastIpAddress"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="lastlogindate">@L["LastLoginDate"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="UserFlagDto" SortLabel="comment">@L["Comment"]</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <PermissionGate AnyOf="PermissionSets.AddEdit">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center; white-space:nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.LockOpen"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(_ => UnlockAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                                   Size="Size.Small"
                                   Color="Color.Secondary"
                                   OnClick="@(_ => ResetPasswordAsync(context))" />
                </MudTd>
            </PermissionGate>
            <MudTd DataLabel="@L["UserIdColumn"]">@context.UserId</MudTd>
            <MudTd DataLabel="@L["FullName"]">@context.FullName</MudTd>
            <MudTd DataLabel="@L["IsLogin"]">@ToYesNo(context.IsLogin)</MudTd>
            <MudTd DataLabel="@L["IsFirstLogin"]">@ToYesNo(context.IsFirstLogin)</MudTd>
            <MudTd DataLabel="@L["IsLocked"]">@ToYesNo(context.IsLocked)</MudTd>
            <MudTd DataLabel="@L["FailedPasswordAttempt"]">@context.FailedPasswordAttempt</MudTd>
            <MudTd DataLabel="@L["LastIpAddress"]">@context.IpAddress</MudTd>
            <MudTd DataLabel="@L["LastLoginDate"]">@context.LastLoginDate?.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="@L["Comment"]">@context.Comment</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoUserFlagsFound"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Maintenance"], href: null),
        new(L["UserFlagManagement"], href: null, disabled: true),
    };

    private MudTable<UserFlagDto>? _table;
    private string? _search;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private async Task<TableData<UserFlagDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await SettingApi.GetUserFlagsAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        return new TableData<UserFlagDto>
        {
            Items = response.Data,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task UnlockAsync(UserFlagDto user)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = L["UnlockUser"],
            ["Message"] = L.Format("UnlockUserConfirm", user.UserId),
            ["ConfirmText"] = L["Unlock"],
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["UnlockUser"], parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await SettingApi.UnlockUserAsync(user.UserId);
        Snackbar.Add(response.Message ?? L["UnlockFailed"], response.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private async Task ResetPasswordAsync(UserFlagDto user)
    {
        var parameters = new DialogParameters { ["UserId"] = user.UserId };
        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>(L["ResetPasswordTitle"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private string ToYesNo(bool? value) => value == true ? L["Yes"] : L["No"];

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
