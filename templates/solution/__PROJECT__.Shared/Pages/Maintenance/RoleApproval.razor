@page "/dashboard/maintenance/role-approval"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject ApprovalApiService ApprovalApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Approval"]</div>
        <h1>@L["RoleApprovalTitle"]</h1>
        <p>@L["ReviewRoleRequests"]</p>
    </div>
    <PermissionGate Action="PermissionAction.Approve">
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="ApproveAll">@L["ApproveAllAction"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DoNotDisturb" OnClick="RejectAll">@L["RejectAllAction"]</MudButton>
        </div>
    </PermissionGate>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="RoleApprovalListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchRequest"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="approval-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="fullname">@L["User"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="groupname">@L["Group"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="canadded">@L["AddEditColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="candelete">@L["DeleteColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="canreadonly">@L["ReadOnlyColumn"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="approvaltype">@L["TypeColumn"]</MudTableSortLabel></MudTh>
            <PermissionGate AnyOf="PermissionSets.ApproveReject">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["User"]">@context.FullName <span class="text-muted">(@context.UserId)</span></MudTd>
            <MudTd DataLabel="@L["Group"]">@(context.GroupName ?? context.GroupId)</MudTd>
            <MudTd DataLabel="@L["AddEditColumn"]">@(context.CanAddEdit ? L["Yes"] : L["No"])</MudTd>
            <MudTd DataLabel="@L["DeleteColumn"]">@(context.CanDelete ? L["Yes"] : L["No"])</MudTd>
            <MudTd DataLabel="@L["ReadOnlyColumn"]">@(context.CanReadOnly ? L["Yes"] : L["No"])</MudTd>
            <MudTd DataLabel="@L["TypeColumn"]">@context.ApprovalType</MudTd>
            <PermissionGate AnyOf="PermissionSets.ApproveReject">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center;">
                    <MudRadioGroup @bind-Value="context.SelectedAction" Class="approval-radios">
                        <MudRadio T="int" Value="1" Color="Color.Primary">@L["Approve"]</MudRadio>
                        <MudRadio T="int" Value="2" Color="Color.Default">@L["Pending"]</MudRadio>
                        <MudRadio T="int" Value="0" Color="Color.Error">@L["Reject"]</MudRadio>
                    </MudRadioGroup>
                </MudTd>
            </PermissionGate>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoPendingRoleRequests"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>

    <PermissionGate Action="PermissionAction.Approve">
        <div class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" Class="@("ryz-busy-button" + (_submitting ? " is-busy" : string.Empty))" Disabled="@_submitting" OnClick="SubmitApprovalsAsync">
                @(_submitting ? L["Submitting"] : L["SubmitAction"])
            </MudButton>
        </div>
    </PermissionGate>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Maintenance"], href: null),
        new(L["RoleApprovalTitle"], href: null, disabled: true),
    };

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private MudTable<RoleApprovalListItemDto>? _table;
    private List<RoleApprovalListItemDto> _currentItems = new();
    private string? _search;
    private bool _submitting;

    private async Task<TableData<RoleApprovalListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ApprovalApi.GetPendingRolesAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        _currentItems = response.Data ?? new List<RoleApprovalListItemDto>();
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 2;
        }

        return new TableData<RoleApprovalListItemDto>
        {
            Items = _currentItems,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void ApproveAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 1;
        }
        StateHasChanged();
    }

    private void RejectAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 0;
        }
        StateHasChanged();
    }

    private async Task SubmitApprovalsAsync()
    {
        if (_submitting)
        {
            return;
        }

        var approveIds = _currentItems.Where(x => x.SelectedAction == 1).Select(x => x.Id).ToList();
        var rejectIds = _currentItems.Where(x => x.SelectedAction == 0).Select(x => x.Id).ToList();

        if (approveIds.Count == 0 && rejectIds.Count == 0)
        {
            Snackbar.Add(L["NoApprovalsSelected"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Title"] = L["ConfirmSubmission"],
            ["Message"] = L.Format("ConfirmSubmissionMessage", approveIds.Count, rejectIds.Count),
            ["ConfirmText"] = "Submit",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["ConfirmSubmission"], parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        _submitting = true;
        try
        {
            var failed = 0;
            foreach (var id in approveIds)
            {
                var response = await ApprovalApi.ApproveRoleAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            foreach (var id in rejectIds)
            {
                var response = await ApprovalApi.RejectRoleAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            Snackbar.Add(
                failed == 0 ? L["ApprovalProcessedSuccess"] : L.Format("ApprovalPartialFailed", failed),
                failed == 0 ? Severity.Success : Severity.Error);
            await _table!.ReloadServerData();
        }
        finally
        {
            _submitting = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
