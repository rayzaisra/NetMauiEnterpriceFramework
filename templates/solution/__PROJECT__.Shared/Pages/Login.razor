@page "/"
@page "/forgot-password"
@page "/reset-password"
@layout MainLayout
@attribute [AllowAnonymous]
@using __PROJECT__.Application.Common
@inject AuthService AuthService
@inject ITokenStorage TokenStorage
@inject INotifyAuthenticationState AuthStateNotifier
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudThemeProvider Theme="LoginTheme" />

@if (IsMauiApp)
{
    <div class="maui-auth-shell neo-brutalism">
        <div class="maui-auth-card">
            <div class="maui-auth-logo">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
            </div>

            <div class="maui-auth-heading">
                <h2>@MauiHeaderTitle</h2>
                <p>@MauiHeaderSubtitle</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            <div class="maui-auth-form-area">
            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="Current Password"
                                      Placeholder="Enter your current password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="New Password"
                                      Placeholder="Enter your new password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="Confirm New Password"
                                      Placeholder="Repeat your new password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Minimum 8 characters, with uppercase, lowercase, number, and special character.
                        </MudText>
                    </div>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="Username or Email"
                                      Placeholder="Enter your username or email"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </div>
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">Back to Sign In</button>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="_forgotLoading">
                        @if (_forgotLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>Send Reset</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="maui-auth-fields">
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">Back to Sign In</button>
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">Reset token is invalid or has expired.</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="New Password"
                                          Placeholder="Enter your new password"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="Confirm New Password"
                                          Placeholder="Repeat your new password"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Minimum 8 characters, with uppercase, lowercase, number, and special character.
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="maui-auth-submit"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Reset Password</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                </div>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="Username"
                                      Placeholder="Enter your username"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="Password"
                                      Placeholder="Enter your password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="maui-auth-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">Remember this device</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">Forgot Password?</button>
                        </div>
                    </div>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>Login</span>
                        }
                    </MudButton>
                </EditForm>
            }
            </div>
        </div>
    </div>
}
else
{
<MudGrid Justify="Justify.Center" Class="@LoginPageClass" Style="min-height:100vh; background:#e7eeff;">
    <MudItem xs="12" md="6" Class="login-brand-item">
        <MudPaper Elevation="0" Class="login-brand-panel">
            <div class="login-brand-top">
                <div class="login-logo">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                </div>
                <div>
                    <div class="login-brand-name">@BrandName</div>
                    <div class="login-brand-subtitle">Enterprise Portal</div>
                </div>
            </div>

            <div class="login-brand-copy">
                <h1>Securing your enterprise future today.</h1>
                <p>Access your high-performance financial dashboard and manage corporate assets with precision-grade tools.</p>
            </div>

            <div class="login-brand-features">
                <div><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /> Enterprise-grade security</div>
                <div><MudIcon Icon="@Icons.Material.Filled.Insights" /> Operational insight</div>
                <div><MudIcon Icon="@Icons.Material.Filled.Settings" /> Configurable modules</div>
            </div>

            <div class="login-brand-footer">© @DateTime.Now.Year @BrandName. Internal use only.</div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" Class="login-form-item">
        <MudPaper Elevation="0" Class="login-form-panel">
            <div class="login-form-header">
                <h2>@HeaderTitle</h2>
                <p>@HeaderSubtitle</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="Old Password"
                                      Placeholder="Enter your default password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="New Password"
                                      Placeholder="Enter your new password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="Confirm New Password"
                                      Placeholder="Repeat your new password"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Minimum 8 characters, with uppercase, lowercase, number, and special character.
                        </MudText>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>Change Password</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="CancelFirstLogin">
                            Back to Sign In
                        </MudButton>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="Username or Email"
                                      Placeholder="Enter your username or email"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="_forgotLoading">
                            @if (_forgotLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>Send Reset Instructions</span>
                            }
                        </MudButton>
                        <button type="button" class="login-text-link" @onclick="ShowSignIn">Back to Sign In</button>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="login-form-fields">
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">Reset token is invalid or has expired.</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="New Password"
                                          Placeholder="Enter your new password"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="Confirm New Password"
                                          Placeholder="Repeat your new password"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Minimum 8 characters, with uppercase, lowercase, number, and special character.
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Reset Password</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                    <button type="button" class="login-text-link" @onclick="ShowSignIn">Back to Sign In</button>
                </div>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="Username"
                                      Placeholder="Enter your ID"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="Password"
                                      Placeholder="••••••••"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="login-form-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">Remember this device</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">Forgot Password?</button>
                        </div>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>Login to Dashboard</span>
                            }
                        </MudButton>
                    </div>
                </EditForm>
            }

            <div class="login-form-footer">
                Need assistance? <MudLink Href="#" Underline="Underline.Always" Style="color:#004481;">Contact Support</MudLink>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
}

@code {
    private const string BrandName = "__PROJECT__";
    private const string StyleStorageKey = "enterprise-ui-style";
    private bool _neoBrutalism = true;
    private static bool IsMauiApp => !OperatingSystem.IsBrowser();
    private string LoginPageClass => $"login-page {(_neoBrutalism ? "neo-brutalism" : "classic-login")}";
    private string MauiHeaderTitle => _requiresPasswordChange ? "Reset Password" : HeaderTitle;
    private string MauiHeaderSubtitle => _requiresPasswordChange
        ? "Set a new password for your account."
        : HeaderSubtitle;

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly LoginRequestDto _loginModel = new();
    private readonly ForgotPasswordRequestDto _forgotModel = new();
    private readonly ResetPasswordRequestDto _resetModel = new();
    private FirstLoginPasswordDto _firstLoginModel = new();
    private LoginMode _mode = LoginMode.SignIn;
    private bool _isLoading;
    private bool _forgotLoading;
    private bool _resetLoading;
    private bool _resetTokenInvalid;
    private bool _requiresPasswordChange;
    private string? _errorMessage;
    private string? _successMessage;

    private enum LoginMode
    {
        SignIn,
        Forgot,
        Reset,
    }

    private string HeaderTitle => _requiresPasswordChange
        ? "Change Password"
        : _mode switch
        {
            LoginMode.Forgot => "Forgot Password",
            LoginMode.Reset => "Reset Password",
            _ => "Sign In",
        };

    private string HeaderSubtitle => _requiresPasswordChange
        ? "This is your first login. Please set a new password before continuing."
        : _mode switch
        {
            LoginMode.Forgot => "Enter your username or email. If the account is registered, reset instructions will be sent.",
            LoginMode.Reset => "Choose a new password for your account.",
            _ => "Please enter your credentials to access your account.",
        };

    protected override async Task OnInitializedAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase))
        {
            _mode = LoginMode.Forgot;
            return;
        }

        if (!path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _mode = LoginMode.Reset;
        _resetModel.Token = Token ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_resetModel.Token))
        {
            _resetTokenInvalid = true;
            Snackbar.Add("Reset token is missing.", Severity.Error);
            return;
        }

        try
        {
            _resetTokenInvalid = !await AuthService.ValidatePasswordResetTokenAsync(_resetModel.Token);
        }
        catch (Exception ex)
        {
            _resetTokenInvalid = true;
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileValidateResetToken", ex);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }

        if (_resetTokenInvalid)
        {
            Snackbar.Add("Reset token is invalid or has expired.", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var savedStyle = await JS.InvokeAsync<string?>("localStorage.getItem", StyleStorageKey);
            if (string.Equals(savedStyle, "classic", StringComparison.OrdinalIgnoreCase))
            {
                _neoBrutalism = false;
                StateHasChanged();
            }
        }
        catch
        {
            // Storage can be unavailable during prerender; keep the default style.
        }
    }

    private readonly MudTheme LoginTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#004481",
            Secondary = "#b6171e",
            Background = "#e7eeff",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Plus Jakarta Sans", "sans-serif" },
            },
        },
    };

    private void ShowForgot()
    {
        _mode = LoginMode.Forgot;
        _errorMessage = null;
        _successMessage = null;
        _forgotModel.UserIdOrEmail = _loginModel.UserId;
    }

    private void ShowSignIn()
    {
        _mode = LoginMode.SignIn;
        _requiresPasswordChange = false;
        _resetTokenInvalid = false;
        _errorMessage = null;
        _successMessage = null;
        _forgotModel.UserIdOrEmail = string.Empty;
        _resetModel.Token = string.Empty;
        _resetModel.NewPassword = string.Empty;
        _resetModel.ConfirmNewPassword = string.Empty;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase)
            || path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnForgotPasswordAsync()
    {
        _forgotLoading = true;
        try
        {
            await AuthService.RequestPasswordResetAsync(_forgotModel.UserIdOrEmail);
            Snackbar.Add("Reset instructions have been queued. Check your email or contact an administrator.", Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileForgotPassword", ex, _forgotModel.UserIdOrEmail);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _forgotLoading = false;
        }
    }

    private async Task OnResetPasswordAsync()
    {
        var policyError = PasswordPolicy.Validate(_resetModel.NewPassword);
        if (policyError != null)
        {
            Snackbar.Add(policyError, Severity.Error);
            return;
        }

        if (!string.Equals(_resetModel.NewPassword, _resetModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("New password and confirmation do not match.", Severity.Error);
            return;
        }

        _resetLoading = true;
        try
        {
            await AuthService.ResetPasswordAsync(_resetModel);
            Snackbar.Add("Password reset successfully. Please sign in with your new password.", Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileResetPassword", ex);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _resetLoading = false;
        }
    }

    private async Task OnLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_loginModel);
            if (response == null)
            {
                _errorMessage = "Login failed.";
                return;
            }

            if (response.RequiresPasswordChange)
            {
                _requiresPasswordChange = true;
                _successMessage = null;
                _firstLoginModel = new FirstLoginPasswordDto
                {
                    UserId = _loginModel.UserId,
                    CurrentPassword = _loginModel.Password,
                };
                _loginModel.Password = string.Empty;
                return;
            }

            await TokenStorage.SetRememberMeAsync(_loginModel.RememberMe);
            await TokenStorage.SetAccessTokenAsync(response.AccessToken);
            await TokenStorage.SetRefreshTokenAsync(response.RefreshToken);
            AuthStateNotifier.NotifyUserLogin(response.User.UserId);
            Snackbar.Add("Login successful", Severity.Success);

            if (response.UrlDestination == "changepassword")
            {
                Navigation.NavigateTo("/change-password", true);
            }
            else
            {
                Navigation.NavigateTo("/dashboard", true);
            }
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileLogin", ex, _loginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFirstLoginPasswordChangeAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        var policyError = PasswordPolicy.Validate(_firstLoginModel.NewPassword);
        if (policyError != null)
        {
            _errorMessage = policyError;
            return;
        }

        if (!string.Equals(_firstLoginModel.NewPassword, _firstLoginModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            _errorMessage = "New password and confirmation do not match.";
            return;
        }

        _isLoading = true;
        try
        {
            await AuthService.ChangeFirstLoginPasswordAsync(_firstLoginModel);
            _requiresPasswordChange = false;
            _firstLoginModel = new FirstLoginPasswordDto();
            _loginModel.Password = string.Empty;
            _successMessage = "Password changed successfully. Please sign in with your new password.";
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileFirstLogin", ex, _firstLoginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowMauiErrorAsync(string source, Exception exception, string? userId = null)
    {
        _errorMessage = null;
        Snackbar.Add(GetMauiErrorMessage(exception), Severity.Error);
        await AuthService.LogClientErrorAsync(source, exception, userId);
    }

    private static string GetMauiErrorMessage(Exception exception)
    {
        if (exception is HttpRequestException or TaskCanceledException
            || exception.Message.Contains('<')
            || exception.Message.Contains("Bad Request", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to connect to the server. Please try again later.";
        }

        return string.IsNullOrWhiteSpace(exception.Message)
            ? "Unable to process the request. Please try again later."
            : exception.Message;
    }

    private void CancelFirstLogin()
    {
        _requiresPasswordChange = false;
        _firstLoginModel = new FirstLoginPasswordDto();
        _errorMessage = null;
        _successMessage = null;
    }
}
