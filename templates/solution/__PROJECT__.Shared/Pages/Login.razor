@page "/"
@page "/forgot-password"
@page "/reset-password"
@layout MainLayout
@attribute [AllowAnonymous]
@using __PROJECT__.Application.Common
@inject AuthService AuthService
@inject ITokenStorage TokenStorage
@inject INotifyAuthenticationState AuthStateNotifier
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ThemePreferenceService ThemeService
@inject MotionService Motion
@inject LanguageService L
@implements IDisposable

<MudThemeProvider Theme="ThemeService.LoginTheme" />

@if (IsMauiApp)
{
    <div class="maui-auth-shell neo-brutalism">
        <div class="maui-auth-card">
            <div class="maui-auth-logo">
                <img src="/images/branding/app-logo.png" alt="" />
            </div>
            <div class="maui-auth-lang">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Class="app-language-toggle maui-language-toggle"
                           aria-label="@L.ToggleAriaLabel"
                           title="@L.ToggleTitle"
                           OnClick="@(_ => ToggleLanguageAsync())">@L.ToggleLabel</MudButton>
            </div>

            <div class="maui-auth-heading">
                <h2>@MauiHeaderTitle</h2>
                <p>@MauiHeaderSubtitle</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            <div class="maui-auth-form-area">
            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="@L["CurrentPassword"]"
                                      Placeholder="@L["EnterCurrentPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="@L["NewPassword"]"
                                      Placeholder="@L["EnterNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="@L["ConfirmNewPassword"]"
                                      Placeholder="@L["RepeatNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                    </div>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["ResetPassword"]</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="@L["UsernameOrEmail"]"
                                      Placeholder="@L["EnterUsernameOrEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </div>
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="_forgotLoading">
                        @if (_forgotLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["SendReset"]</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="maui-auth-fields">
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">@L["ResetTokenInvalidOrExpired"]</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="@L["NewPassword"]"
                                          Placeholder="@L["EnterNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="@L["ConfirmNewPassword"]"
                                          Placeholder="@L["RepeatNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["PasswordMinLength"]
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="maui-auth-submit"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>@L["ResetPassword"]</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                </div>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="@L["Username"]"
                                      Placeholder="@L["EnterUsername"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="@L["EnterPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="maui-auth-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">@L["RememberThisDevice"]</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">@L["ForgotPasswordQuestion"]</button>
                        </div>
                    </div>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["Login"]</span>
                        }
                    </MudButton>
                </EditForm>
            }
            </div>
        </div>
    </div>
}
else
{
<div class="@LoginPageClass login-shell">
    <section class="login-brand-item">
        <MudPaper Elevation="0" Class="login-brand-panel">
            <div class="login-brand-top">
                <div class="login-logo">
                    <img src="/images/branding/app-logo.png" alt="" />
                </div>
                <div>
                    <div class="login-brand-name">@BrandName</div>
                    <div class="login-brand-subtitle">Enterprise Coding Framework</div>
                </div>
            </div>

            <div class="login-brand-visual">
                <img src="/images/login/login-illustration.png"
                     alt="@L["EnterpriseWorkspaceIllustration"]"
                     loading="eager" />
            </div>

            <div class="login-brand-copy">
                <h1>@L["BuiltOnBedrock"]</h1>
                <p>@BrandManifesto</p>
                <div class="login-brand-proof" aria-label="@L["MainModules"]">
                    <span class="login-brand-proof-chip">@L["Authentication"]</span>
                    <span class="login-brand-proof-chip">@L["MenuMapping"]</span>
                    <span class="login-brand-proof-chip">@L["ParameterMaster"]</span>
                    <span class="login-brand-proof-chip">@L["Approval"]</span>
                </div>
            </div>
        </MudPaper>
    </section>

    <section class="login-form-item">
        <MudPaper Elevation="0" Class="login-form-panel">
            <div class="login-form-header">
                <div class="login-form-header-top">
                    <div>
                        <h2>@HeaderTitle</h2>
                        <p>@HeaderSubtitle</p>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="app-language-toggle"
                               aria-label="@L.ToggleAriaLabel"
                               title="@L.ToggleTitle"
                               OnClick="@(_ => ToggleLanguageAsync())">@L.ToggleLabel</MudButton>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="@L["OldPassword"]"
                                      Placeholder="@L["EnterDefaultPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="@L["NewPassword"]"
                                      Placeholder="@L["EnterNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="@L["ConfirmNewPassword"]"
                                      Placeholder="@L["RepeatNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["ChangePassword"]</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="CancelFirstLogin">
                            @L["BackToSignIn"]
                        </MudButton>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="@L["UsernameOrEmail"]"
                                      Placeholder="@L["EnterUsernameOrEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="_forgotLoading">
                            @if (_forgotLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["ResetInstructionsSent"]</span>
                            }
                        </MudButton>
                        <button type="button" class="login-text-link" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="login-form-fields">
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">@L["ResetTokenInvalidOrExpired"]</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="@L["NewPassword"]"
                                          Placeholder="@L["EnterNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="@L["ConfirmNewPassword"]"
                                          Placeholder="@L["RepeatNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["PasswordMinLength"]
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>@L["ResetPassword"]</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                    <button type="button" class="login-text-link" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                </div>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="@L["Username"]"
                                      Placeholder="@L["EnterUsername"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="••••••••"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="login-form-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">@L["RememberThisDevice"]</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">@L["ForgotPasswordQuestion"]</button>
                        </div>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["LoginToDashboard"]</span>
                            }
                        </MudButton>
                    </div>
                </EditForm>
            }

        </MudPaper>
    </section>
</div>
}

@code {
    private const string BrandName = "__PROJECT__";
    private const string BrandManifesto =
        "RyzCore merupakan framework coding yang dikembangkan berdasarkan pengalaman panjang dalam pengembangan aplikasi perusahaan. Dengan menyediakan pola-pola inti yang telah terbukti melalui penggunaan berulang, RyzCore dirancang untuk memangkas waktu development dan mempercepat tim dalam memenuhi kebutuhan bisnis.";
    private static bool IsMauiApp => !OperatingSystem.IsBrowser();
    private string LoginPageClass => $"login-page {(ThemeService.IsNeoBrutalism ? "neo-brutalism" : "classic-login")} palette-{ThemeService.Palette}";
    private string MauiHeaderTitle => _requiresPasswordChange ? L["ResetPassword"] : HeaderTitle;
    private string MauiHeaderSubtitle => _requiresPasswordChange
        ? L["ChooseNewPassword"]
        : _mode switch
        {
            LoginMode.Forgot => L["ForgotPasswordSubtitle"],
            LoginMode.Reset => L["ChooseNewPassword"],
            _ => L["EnterCredentialsToContinue"],
        };

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly LoginRequestDto _loginModel = new();
    private readonly ForgotPasswordRequestDto _forgotModel = new();
    private readonly ResetPasswordRequestDto _resetModel = new();
    private FirstLoginPasswordDto _firstLoginModel = new();
    private LoginMode _mode = LoginMode.SignIn;
    private bool _isLoading;
    private bool _forgotLoading;
    private bool _resetLoading;
    private bool _resetTokenInvalid;
    private bool _requiresPasswordChange;
    private string? _errorMessage;
    private string? _successMessage;

    private enum LoginMode
    {
        SignIn,
        Forgot,
        Reset,
    }

    private string HeaderTitle => _requiresPasswordChange
        ? L["ChangePassword"]
        : _mode switch
        {
            LoginMode.Forgot => L["ForgotPassword"],
            LoginMode.Reset => L["ResetPassword"],
            _ => L["SignIn"],
        };

    private string HeaderSubtitle => _requiresPasswordChange
        ? L["FirstLoginPasswordSubtitle"]
        : _mode switch
        {
            LoginMode.Forgot => L["ForgotPasswordSubtitle"],
            LoginMode.Reset => L["ChooseNewPassword"],
            _ => L["EnterCredentialsToContinue"],
        };

    protected override async Task OnInitializedAsync()
    {
        L.OnChange += HandleLanguageChanged;
        await ThemeService.InitializeAsync();
        await L.InitializeAsync();

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase))
        {
            _mode = LoginMode.Forgot;
            return;
        }

        if (!path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _mode = LoginMode.Reset;
        _resetModel.Token = Token ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_resetModel.Token))
        {
            _resetTokenInvalid = true;
            Snackbar.Add(L["ResetTokenMissing"], Severity.Error);
            return;
        }

        try
        {
            _resetTokenInvalid = !await AuthService.ValidatePasswordResetTokenAsync(_resetModel.Token);
        }
        catch (Exception ex)
        {
            _resetTokenInvalid = true;
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileValidateResetToken", ex);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }

        if (_resetTokenInvalid)
        {
            Snackbar.Add(L["ResetTokenInvalidOrExpired"], Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeService.InitializeAsync();
    }

    private void ShowForgot()
    {
        _mode = LoginMode.Forgot;
        _errorMessage = null;
        _successMessage = null;
    }

    private async Task ToggleLanguageAsync() => await L.ToggleAsync();

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void ShowSignIn()
    {
        _mode = LoginMode.SignIn;
        _requiresPasswordChange = false;
        _resetTokenInvalid = false;
        _errorMessage = null;
        _successMessage = null;
        _forgotModel.UserIdOrEmail = string.Empty;
        _resetModel.Token = string.Empty;
        _resetModel.NewPassword = string.Empty;
        _resetModel.ConfirmNewPassword = string.Empty;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase)
            || path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnForgotPasswordAsync()
    {
        if (_forgotLoading)
        {
            return;
        }

        _forgotLoading = true;
        try
        {
            await AuthService.RequestPasswordResetAsync(_forgotModel.UserIdOrEmail);
            Snackbar.Add(L["ResetInstructionsQueued"], Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileForgotPassword", ex, _forgotModel.UserIdOrEmail);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _forgotLoading = false;
        }
    }

    private async Task OnResetPasswordAsync()
    {
        if (_resetLoading)
        {
            return;
        }

        var policyError = PasswordPolicy.Validate(_resetModel.NewPassword);
        if (policyError != null)
        {
            Snackbar.Add(policyError, Severity.Error);
            return;
        }

        if (!string.Equals(_resetModel.NewPassword, _resetModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            Snackbar.Add(L["NewPasswordAndConfirmationDoNotMatch"], Severity.Error);
            return;
        }

        _resetLoading = true;
        try
        {
            await AuthService.ResetPasswordAsync(_resetModel);
            Snackbar.Add(L["PasswordChangedSuccessfully"], Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileResetPassword", ex);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _resetLoading = false;
        }
    }

    private async Task OnLoginAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_loginModel);
            if (response == null)
            {
                _errorMessage = "Login failed.";
                return;
            }

            if (response.RequiresPasswordChange)
            {
                _requiresPasswordChange = true;
                _successMessage = null;
                _firstLoginModel = new FirstLoginPasswordDto
                {
                    UserId = _loginModel.UserId,
                    CurrentPassword = _loginModel.Password,
                };
                _loginModel.Password = string.Empty;
                return;
            }

            await TokenStorage.SetRememberMeAsync(_loginModel.RememberMe);
            await TokenStorage.SetAccessTokenAsync(response.AccessToken);
            await TokenStorage.SetRefreshTokenAsync(response.RefreshToken);
            AuthStateNotifier.NotifyUserLogin(response.User.UserId);

            if (response.UrlDestination == "changepassword")
            {
                Navigation.NavigateTo("/change-password", true);
            }
            else if (IsMauiApp)
            {
                Navigation.NavigateTo("/maui/dashboard");
            }
            else
            {
                await Motion.BeginRouteTransitionAsync();
                await Task.Delay(180);
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileLogin", ex, _loginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFirstLoginPasswordChangeAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _errorMessage = null;
        _successMessage = null;

        var policyError = PasswordPolicy.Validate(_firstLoginModel.NewPassword);
        if (policyError != null)
        {
            _errorMessage = policyError;
            return;
        }

        if (!string.Equals(_firstLoginModel.NewPassword, _firstLoginModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            _errorMessage = L["NewPasswordAndConfirmationDoNotMatch"];
            return;
        }

        _isLoading = true;
        try
        {
            await AuthService.ChangeFirstLoginPasswordAsync(_firstLoginModel);
            _requiresPasswordChange = false;
            _firstLoginModel = new FirstLoginPasswordDto();
            _loginModel.Password = string.Empty;
            _successMessage = L["PasswordChangedSuccessfully"];
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileFirstLogin", ex, _firstLoginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowMauiErrorAsync(string source, Exception exception, string? userId = null)
    {
        _errorMessage = null;
        Snackbar.Add(GetMauiErrorMessage(exception), Severity.Error);
        await AuthService.LogClientErrorAsync(source, exception, userId);
    }

    private static string GetMauiErrorMessage(Exception exception)
    {
        if (exception is HttpRequestException or TaskCanceledException
            || exception.Message.Contains('<')
            || exception.Message.Contains("Bad Request", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to connect to the server. Please try again later.";
        }

        return string.IsNullOrWhiteSpace(exception.Message)
            ? "Unable to process the request. Please try again later."
            : exception.Message;
    }

    private void CancelFirstLogin()
    {
        _requiresPasswordChange = false;
        _firstLoginModel = new FirstLoginPasswordDto();
        _errorMessage = null;
        _successMessage = null;
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
