@page "/maui/notifications"
@layout MauiAuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject NotificationApiService NotificationApi
@inject MotionService Motion
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject LanguageService L

<div class="maui-notifications-page">
    <div class="maui-menu-header maui-notifications-header">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       aria-label="@L["Back"]"
                       OnClick="BackToDashboard" />
        <h1>@L["Notifications"]</h1>
        @if (_unreadCount > 0)
        {
            <button type="button" class="maui-text-link" @onclick="MarkAllReadAsync">@L["MarkAllRead"]</button>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_notifications.Count == 0)
    {
        <div class="maui-notification-empty">
            <MudIcon Icon="@Icons.Material.Outlined.NotificationsOff" Size="Size.Large" />
            <strong>@L["NoNotifications"]</strong>
            <span>@L["NotificationsWillAppearHere"]</span>
        </div>
    }
    else
    {
        <div class="maui-notification-list">
            @foreach (var notification in _notifications)
            {
                <button type="button"
                        class="maui-notification-card @(!notification.IsSeen ? "is-unread" : "")"
                        @onclick="() => OpenNotificationAsync(notification)">
                    <span class="maui-notification-icon">
                        <MudIcon Icon="@(notification.IsSeen ? Icons.Material.Outlined.NotificationsNone : Icons.Material.Filled.Notifications)" Size="Size.Small" />
                    </span>
                    <span class="maui-notification-copy">
                        <span class="maui-notification-title">
                            @(notification.ShortText ?? notification.Type ?? L["Notification"])
                        </span>
                        @if (!string.IsNullOrWhiteSpace(notification.LongText))
                        {
                            <span class="maui-notification-message">@notification.LongText</span>
                        }
                        <span class="maui-notification-date">@notification.CreatedDate?.ToString("dd MMM yyyy HH:mm")</span>
                    </span>
                    @if (!notification.IsSeen)
                    {
                        <span class="maui-notification-dot" aria-label="@L["Unread"]"></span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private List<NotificationDto> _notifications = new();
    private bool _loading = true;
    private int _unreadCount;
    private bool _motionPlayed;

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        _ = LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _motionPlayed)
        {
            return;
        }

        _motionPlayed = true;
        await Motion.PlayNotificationsAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _notifications = await NotificationApi.GetRecentAsync(100);
            _unreadCount = _notifications.Count(item => !item.IsSeen);
        }
        catch
        {
            Snackbar.Add(L["FailedLoadNotifications"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenNotificationAsync(NotificationDto notification)
    {
        if (!notification.IsSeen)
        {
            await NotificationApi.MarkSeenAsync(notification.Id);
            notification.IsSeen = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        if (!string.IsNullOrWhiteSpace(notification.Href))
        {
            Navigation.NavigateTo(notification.Href);
        }
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationApi.MarkAllSeenAsync();
        foreach (var notification in _notifications)
        {
            notification.IsSeen = true;
        }

        _unreadCount = 0;
        Snackbar.Add(L["AllNotificationsMarkedRead"], Severity.Success);
    }

    private void BackToDashboard() => Navigation.NavigateTo("/maui/dashboard");

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
