@page "/error"
@page "/not-found"
@layout MainLayout
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-6 ryz-error-page">
    <MudPaper Elevation="0" Class="ryz-error-card">
        <div class="ryz-error-kicker">RyzCore Workspace</div>
        <h1>Page not found</h1>
        <p class="ryz-error-copy">The page you requested is not available in this workspace. Return to the dashboard to continue your work in the main content tabs.</p>
        <div class="ryz-error-actions">
            <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary">Go to Dashboard</MudButton>
            <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Primary">Go to Sign In</MudButton>
        </div>
    </MudPaper>
</MudContainer>
