@page "/notifications"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject NotificationApiService NotificationApi
@inject MotionService Motion
@inject ISnackbar Snackbar
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-4" />

<div class="page-heading">
    <div>
        <h1>@L["Notifications"]</h1>
        <p>@L["NotificationsWillAppearHere"]</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DoneAll"
                   OnClick="MarkAllReadAsync">
            @L["MarkAllRead"]
        </MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="notification-page-panel">
    <div class="notification-toolbar">
        <MudTextField @bind-Value="_search"
                      @bind-Value:after="ApplyFilter"
                      Label="@L["Search"]"
                      Placeholder="@L["SearchNotifications"]"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="notification-search" />
    </div>

    <MudTable Items="_filtered"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Striped="true"
              Bordered="true"
              Class="mt-4">
        <HeaderContent>
            <MudTh>@L["Action"]</MudTh>
            <MudTh><MudTableSortLabel T="NotificationDto" SortLabel="shorttext" SortBy="new Func<NotificationDto, object>(x => x.ShortText ?? string.Empty)">@L["Notification"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="NotificationDto" SortLabel="createddate" SortBy="new Func<NotificationDto, object>(x => x.CreatedDate ?? DateTime.MinValue)">@L["Date"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="NotificationDto" SortLabel="isseen" SortBy="new Func<NotificationDto, object>(x => x.IsSeen)">@L["Status"]</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Action">
                @if (!context.IsSeen)
                {
                    <MudTooltip Text="@L["MarkAsRead"]">
                        <MudIconButton Icon="@Icons.Material.Filled.MarkEmailRead"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       aria-label="@L["MarkAsRead"]"
                                       OnClick="@(() => MarkReadAsync(context))" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="@L["Notification"]">
                <div class="d-flex align-start gap-2">
                    @if (!context.IsSeen)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.MarkEmailUnread" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
                    }
                    <div>
                        <MudText Typo="Typo.body2" Style="@(context.IsSeen ? "font-weight:400;" : "font-weight:700;")">
                            @(context.ShortText ?? context.Type ?? L["Notification"])
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.LongText</MudText>
                    </div>
                </div>
            </MudTd>
            <MudTd DataLabel="@L["Date"]">@context.CreatedDate?.ToString("dd MMM yyyy HH:mm")</MudTd>
            <MudTd DataLabel="@L["Status"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsSeen ? Color.Default : Color.Primary)" Variant="Variant.Outlined">
                    @(context.IsSeen ? L["MarkAllRead"] : L["Unread"])
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="notification-empty">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Color="Color.Error" Size="Size.Large" />
                <MudText Color="Color.Error">@L["NoNotifications"]</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Notifications"], href: null, disabled: true),
    };

    private List<NotificationDto> _notifications = new();
    private List<NotificationDto> _filtered = new();
    private string _search = string.Empty;

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
        _ = LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Motion.PlayNotificationsAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _notifications = await NotificationApi.GetRecentAsync(100);
            ApplyFilter();
        }
        catch
        {
            Snackbar.Add(L["UnableToLoadNotifications"], Severity.Error);
        }
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = string.IsNullOrWhiteSpace(term)
            ? _notifications
            : _notifications
                .Where(n => (n.ShortText ?? n.LongText ?? string.Empty)
                    .Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task MarkReadAsync(NotificationDto notification)
    {
        await NotificationApi.MarkSeenAsync(notification.Id);
        notification.IsSeen = true;
        ApplyFilter();
        Snackbar.Add(L["NotificationMarkedRead"], Severity.Success);
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationApi.MarkAllSeenAsync();
        foreach (var notification in _notifications)
        {
            notification.IsSeen = true;
        }

        ApplyFilter();
        Snackbar.Add(L["AllNotificationsMarkedRead"], Severity.Success);
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
