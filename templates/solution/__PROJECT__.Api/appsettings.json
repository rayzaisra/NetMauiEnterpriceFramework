{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "AuditLogConnection": ""
  },
  "Jwt": {
    "Secret": "__JWT_SECRET__",
    "Issuer": "__API_URL__",
    "Audience": "__WEB_URL__",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SessionRefreshTokenHours": 12,
    "RememberMeExpirationDays": 30
  },
  "PasswordReset": {
    "PublicBaseUrl": "__WEB_URL__"
  },
  "AppSettings": {
    "PasswordExpiryDays": 90,
    "PasswordWarningDays": 10
  },
  "Encryption": {
    "PassPhrase": "__ENCRYPTION_PASSPHRASE__"
  },
  "Cors": {
    "AllowedOrigins": [
      "__WEB_URL__"
    ]
  },
  "AuditActivity": {
    "Enabled": true,
    "QueueCapacity": 10000,
    "BatchSize": 100,
    "FlushIntervalSeconds": 2,
    "ExcludedPaths": [
      "/health",
      "/swagger",
      "/hangfire",
      "/favicon.ico"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/forgot-password",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/reset-password",
        "Period": "15m",
        "Limit": 10
      }
    ]
  }
}
